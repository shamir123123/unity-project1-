--!strict
return function()
	local Needs = require(script.Parent)
	describe("Household goods", function()
		it("consumption follows actual residents and elapsed simulation days", function()
			local h = {goodsStock = 2, goodsUpdatedAt = 10}
			Needs.advance(h, 6, 10.5, 1)
			expect(h.goodsStock).to.equal(1.5)
		end)
		it("larger families consume more goods", function()
			local small = {goodsStock = 2, goodsUpdatedAt = 0}
			local large = {goodsStock = 2, goodsUpdatedAt = 0}
			Needs.advance(small, 3, 1, 1)
			Needs.advance(large, 6, 1, 1)
			expect(small.goodsStock).to.equal(1.5)
			expect(large.goodsStock).to.equal(1)
		end)
		it("shopping starts only when stocks reach their order point", function()
			expect(Needs.wantsShopping({goodsStock = 0.6}, 6)).to.equal(false)
			expect(Needs.wantsShopping({goodsStock = 0.5}, 6)).to.equal(true)
		end)
		it("only goods actually bought replenish the household", function()
			local h = {goodsStock = 0.25}
			Needs.buy(h, 0)
			expect(h.goodsStock).to.equal(0.25)
			Needs.buy(h, 0.75)
			expect(h.goodsStock).to.equal(1)
		end)
		it("stocks never become negative", function()
			local h = {goodsStock = 1, goodsUpdatedAt = 0}
			Needs.advance(h, 6, 20, 1)
			expect(h.goodsStock).to.equal(0)
		end)
		it("a clock rewind does not create goods", function()
			local h = {goodsStock = 1, goodsUpdatedAt = 10}
			Needs.advance(h, 6, 5, 1)
			expect(h.goodsStock).to.equal(1)
		end)
		it("stock restores without refilling a saved empty pantry", function()
			expect(Needs.restore(0, 6)).to.equal(0)
			expect(Needs.restore(1.25, 6)).to.equal(1.25)
			expect(Needs.restore(math.huge, 6)).to.equal(nil)
			expect(Needs.restore("bad", 6)).to.equal(nil)
		end)
		it("legacy starter stock is stable and staggered", function()
			local a, b, c = {}, {}, {}
			Needs.advance(a, 3, 10, 1)
			Needs.advance(b, 3, 10, 1)
			Needs.advance(c, 3, 10, 2)
			expect(a.goodsStock).to.equal(b.goodsStock)
			expect(a.goodsStock ~= c.goodsStock).to.equal(true)
		end)
	end)
end
